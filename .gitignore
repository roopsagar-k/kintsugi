# ============================================
# WATSONX HACKATHON — SECURITY .gitignore
# DO NOT REMOVE OR MODIFY THE SECURITY PATTERNS BELOW
# ============================================

# ── Secrets & local config (NEVER commit) ──────────────────────────────────────
# Environment files
.env
.env.*
*.env
env.local
.env.local
.env.*.local
!.env.example

# Real MCP config holds live API keys — commit .bob/mock-mcp.json instead.
.bob/mcp.json

# IBM Cloud / service credentials
ibmcloud-credentials.json
ibm-credentials.env
*-credentials.json
*apikey*
*api-key*
*api_key*

# Configuration files that may contain credentials
config.json
config.yaml
config.yml
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_dsa
*.ppk

# Generic credential patterns (filenames)
*credentials*
*secret*
*password*
*token*

# Database credentials
database.yml
database.json
db-config.*

# ── AI assistant session files ──────────────────────────────────────────────────
# NOTE: the .bob/ folder (modes, skills, rules, exported reports) IS committed for
# submission — only the live mcp.json with real keys is excluded (see above).
.copilot/
.cursor/
.codeium/
.claude/
CLAUDE.md

# ── Dependencies & build output ─────────────────────────────────────────────────
node_modules/
dist/
.next/
out/
*.tsbuildinfo
.vercel

# ── Kintsugi runtime state (per-project, regenerated by init_project) ────────────
.kintsugi/

# ── Editor / OS / logs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.log
# Auto-generated by `next dev`:
apps/dashboard/AGENTS.md

# ============================================
# DO NOT REMOVE ABOVE PATTERNS
# Add project-specific patterns below
# ============================================
