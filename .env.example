# ============================================
# WATSONX HACKATHON — ENVIRONMENT VARIABLES (Kintsugi)
# ============================================
#
# INSTRUCTIONS:
# 1. The dashboard reads its config from apps/dashboard/.env.local
#      cp apps/dashboard/.env.example apps/dashboard/.env.local
# 2. Replace the placeholder values below with your actual credentials.
# 3. NEVER commit any .env / .env.local file (they are in .gitignore).
# 4. NEVER paste credentials into code or into an AI assistant prompt.
# 5. The Bob MCP server reads its live key from .bob/mcp.json (gitignored);
#    commit .bob/mock-mcp.json (placeholders) instead.
#
# Access values in code with process.env.VARIABLE_NAME — never hardcode them.
# ============================================

# ── App ──────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── IBM Cloudant (database) ──────────────────────────────────────────────────────
# IBM Cloud → Databases for Cloudant → Service credentials → copy url + apikey
CLOUDANT_URL=https://<host>.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your_cloudant_apikey_here_DO_NOT_COMMIT
CLOUDANT_DB=kintsugi

# ── IBM Cloud Object Storage (screenshots / traces) ──────────────────────────────
# IBM Cloud → Object Storage → create a bucket → Service credentials
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET=kintsugi-artifacts
COS_APIKEY=your_cos_apikey_here_DO_NOT_COMMIT
COS_INSTANCE_CRN=your_cos_instance_crn_here_DO_NOT_COMMIT
# HMAC alternative (only if you created the credential with {"HMAC":true}):
# COS_ACCESS_KEY_ID=
# COS_SECRET_ACCESS_KEY=

# ── IBM watsonx.ai (failure triage) ──────────────────────────────────────────────
# IBM Cloud → watsonx.ai → create a project → Manage → General → copy Project ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_watsonx_apikey_here_DO_NOT_COMMIT
WATSONX_PROJECT_ID=your_watsonx_project_id_here_DO_NOT_COMMIT
WATSONX_MODEL=ibm/granite-4-h-small

# ── Auth.js (dashboard sign-in — optional, not needed for the API/MCP) ────────────
AUTH_SECRET=your_auth_secret_here_DO_NOT_COMMIT
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit (placeholders only).
# - Your actual .env.local files are in .gitignore.
# - If a credential is ever exposed, rotate it immediately (see SECURITY.MD).
# ============================================
