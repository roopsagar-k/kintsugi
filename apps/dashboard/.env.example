# Kintsugi dashboard — copy to .env.local and fill in. Never commit real values.
# (.env* is gitignored.) After filling in Cloudant, run:
#   npm run db:setup   # create the kintsugi DB + indexes
#   npm run db:seed    # create a demo project + API key (prints the key once)

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── IBM Cloudant (database) ──────────────────────────────────────────────────────
# IBM Cloud → Databases for Cloudant → Service credentials → create → copy url + apikey
CLOUDANT_URL=https://<host>.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=
CLOUDANT_DB=kintsugi

# ── IBM Cloud Object Storage (media / screenshots / traces) ──────────────────────
# IBM Cloud → Object Storage → create a bucket, then Service credentials.
# Endpoint: the bucket's regional public endpoint (prefix with https://).
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET=kintsugi-artifacts
# Auth option A — IAM (recommended): credential's "apikey" + "resource_instance_id"
COS_APIKEY=
COS_INSTANCE_CRN=
# Auth option B — HMAC: create the credential with {"HMAC":true}, then use these
# COS_ACCESS_KEY_ID=
# COS_SECRET_ACCESS_KEY=
# If COS is left unset, media falls back to Cloudant attachments automatically.

# ── IBM watsonx.ai (failure triage) ──────────────────────────────────────────────
# IBM Cloud → watsonx.ai → create a project → Manage → General → copy Project ID.
# WATSONX_APIKEY is an IBM Cloud IAM API key with access to the watsonx service.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL=ibm/granite-4-h-small

# ── Auth.js (NextAuth v5) — dashboard sign-in (not required for the API/MCP) ──────
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
